# Copy to .env and fill in. Only PUBLIC client configuration belongs here.
# Never put a service-role / secret key in this file or anywhere in the app bundle.

# "development" | "preview" | "production"
EXPO_PUBLIC_APP_ENV=development

# Demo Mode runs entirely on local sample data with a visible banner.
# When true (or when the two Supabase values below are missing) the app never
# contacts a backend.
EXPO_PUBLIC_DEMO_MODE=false

# Supabase project URL and publishable (anon) client key.
# Local stack: run `npm run db:start` then `npm run db:env` to write these into .env.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
